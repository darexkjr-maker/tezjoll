{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/free-chapter", "destination": "/free-chapter.html"},
    {"source": "/discount", "destination": "/discount.html"},
    {"source": "/Free-Chapter", "destination": "/free-chapter.html"},
    {"source": "/Discount", "destination": "/discount.html"},
    {"source": "/chapter-full", "destination": "/chapter-full.html"},
    {"source": "/BingSiteAuth.xml", "destination": "/BingSiteAuth.xml"},
    {"source": "/bingsiteauth.xml", "destination": "/BingSiteAuth.xml"},
    {"source": "/sitemap.xml", "destination": "/sitemap.xml"},
    {"source": "/llms.txt", "destination": "/llms.txt"},
    {"source": "/ai.txt", "destination": "/ai.txt"},
    {"source": "/robots.txt", "destination": "/robots.txt"},
    {"source": "/og-image.jpg", "destination": "/og-image.jpg"},
    {"source": "/googled7f9b130046a34e5.html", "destination": "/googled7f9b130046a34e5.html"}
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "tez-puce.vercel.app"}],
      "destination": "https://codebydalin.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "tezjoll.vercel.app"}],
      "destination": "https://codebydalin.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "tezjoll-darexkjr-makers-projects.vercel.app"}],
      "destination": "https://codebydalin.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    },
    {
      "source": "/BingSiteAuth.xml",
      "headers": [{"key": "Content-Type", "value": "text/xml"}]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {"key": "Content-Type", "value": "application/xml"},
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{"key": "Content-Type", "value": "text/plain"}]
    },
    {
      "source": "/llms.txt",
      "headers": [{"key": "Content-Type", "value": "text/plain"}]
    },
    {
      "source": "/ai.txt",
      "headers": [{"key": "Content-Type", "value": "text/plain"}]
    },
    {
      "source": "/googled7f9b130046a34e5.html",
      "headers": [{"key": "Content-Type", "value": "text/html"}]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {"key": "Content-Type", "value": "image/jpeg"},
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ]
}
