{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/free-chapter",
      "destination": "/free-chapter.html"
    },
    {
      "source": "/discount",
      "destination": "/discount.html"
    },
    {
      "source": "/Free-Chapter",
      "destination": "/free-chapter.html"
    },
    {
      "source": "/Discount",
      "destination": "/discount.html"
    },
    {
      "source": "/chapter-full",
      "destination": "/chapter-full.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tez-puce.vercel.app"
        }
      ],
      "destination": "https://codebydalin.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}