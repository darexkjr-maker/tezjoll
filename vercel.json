{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon*.png",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/free-chapter",
      "dest": "/free-chapter.html"
    },
    {
      "src": "/discount",
      "dest": "/discount.html"
    },
    {
      "src": "/Free-Chapter",
      "dest": "/free-chapter.html"
    },
    {
      "src": "/Discount",
      "dest": "/discount.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}